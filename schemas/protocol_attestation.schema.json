{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javen-chris.github.io/short-drama-production-control/schemas/protocol_attestation.schema.json",
  "title": "Protocol read attestation",
  "description": "Proof that an agent read the common rules and current Gate's protocol bundle for a RUN contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["attestation_id", "task_id", "run_id", "contract_id", "scope_gate", "covered_step_ids", "agent", "manifest_fingerprint", "read_files", "answers", "declared_at"],
  "properties": {
    "attestation_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "contract_id": {"type": "string", "minLength": 1},
    "scope_gate": {"type": "string", "pattern": "^G[0-8]$"},
    "covered_step_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^S[0-9]{2}$"}},
    "agent": {"enum": ["hermes", "codex", "workbuddy", "human", "other"]},
    "manifest_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "read_files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "answers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "answer"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "answer": {"type": "string", "minLength": 1}
        }
      }
    },
    "declared_at": {"type": "string", "minLength": 1}
  }
}
