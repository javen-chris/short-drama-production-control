{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javen-chris.github.io/short-drama-production-control/schemas/run_state.schema.json",
  "title": "Pipeline run state and event log",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "contract_id",
    "current_step",
    "status"
  ],
  "$defs": {
    "protocolAttestation": {
      "type": "object",
      "required": ["status", "attestation_id", "run_id", "task_id", "contract_id", "manifest_fingerprint", "scope_gate", "covered_step_ids", "protocol_paths", "challenge_ids", "verified_at"],
      "properties": {
        "status": {"const": "PASS"},
        "attestation_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "contract_id": {"type": "string", "minLength": 1},
        "manifest_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "scope_gate": {"type": "string", "pattern": "^G[0-8]$"},
        "covered_step_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "protocol_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "challenge_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "verified_at": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "current_step": {
      "type": "string",
      "minLength": 0
    },
    "pipeline": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "segment": {"type": "string"},
    "segment_title": {"type": "string"},
    "series": {"type": "string"},
    "episode": {"type": "string"},
    "project_root": {"type": "string"},
    "updated_at": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "execution_model": {"type": "string", "minLength": 1},
    "qa_model": {"type": "string", "minLength": 1},
    "execution_contract": {"type": "object"},
    "protocol_attestation": {"$ref": "#/$defs/protocolAttestation"},
    "protocol_attestations": {
      "type": "array",
      "items": {"$ref": "#/$defs/protocolAttestation"}
    },
    "step_dispositions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["applicable", "reason", "step_id", "disposition"],
        "properties": {
          "applicable": {"type": "boolean"},
          "reason": {"type": "string", "minLength": 1},
          "step_id": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["pending", "not_applicable"]}
        },
        "additionalProperties": false
      }
    },
    "status": {
      "enum": [
        "RUNNING",
        "WAITING_APPROVAL",
        "PAUSED_EXCEPTION",
        "COMPLETED",
        "COMPLETED_WITH_CONTINUITY_CAVEAT",
        "USABLE_WITH_SCENE_CONTINUITY_FAIL",
        "SUBMITTED_FOR_QA",
        "SUBMITTED_IN_PROGRESS",
        "FAILED",
        "BLOCKED"
      ]
    },
    "checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "completed_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pending_decision": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "outcome"
        ],
        "properties": {
          "actor": {
            "type": "string",
            "description": "生产提交事件记录执行模型；QA 结论事件记录独立 QA 模型"
          },
          "affected_files": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "blocking_issues": {
            "type": "array",
            "items": {"type": "string"}
          },
          "execution_model": {"type": "string", "minLength": 1},
          "elapsed_seconds": {"type": "integer", "minimum": 0},
          "evidence_waived": {"type": "boolean"},
          "gate": {"type": "string", "minLength": 1},
          "issue_id": {"type": "string", "minLength": 1},
          "next_step": {"type": "string", "minLength": 1},
          "off_protocol": {"type": "boolean"},
          "qa_attempt": {"type": "integer", "minimum": 1, "maximum": 2},
          "qa_conclusion": {"enum": ["PASS", "FAIL", "CONDITIONAL", "TIMEOUT"]},
          "qa_level": {"enum": ["A", "B", "C", "FINAL"]},
          "role": {"enum": ["producer", "qa"]},
          "step_as_written": {"type": "string"},
          "step_id": {"type": "string", "minLength": 1},
          "contract_id": {"type": "string", "minLength": 1},
          "step_matched_fuzzy": {"type": "number", "minimum": 0, "maximum": 1},
          "task_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "writer_model": {"type": "string", "minLength": 1},
          "at": {
            "type": "string",
            "minLength": 1
          },
          "attestation_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "SUBMITTED_FOR_QA",
              "SUBMITTED_IN_PROGRESS",
              "COMPLETED",
              "COMPLETED_WITH_CONTINUITY_CAVEAT",
              "USABLE_WITH_SCENE_CONTINUITY_FAIL",
              "WAITING_APPROVAL",
              "PAUSED_EXCEPTION",
              "BLOCKED",
              "FAILED"
            ]
          },
          "protocol_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "skill_id": {
            "type": "string",
            "minLength": 1
          },
          "step": {
            "type": "string",
            "minLength": 1
          },
          "validator": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {"properties": {"outcome": {"const": "SUBMITTED_FOR_QA"}}},
            "then": {"required": ["actor", "writer_model", "task_id", "version", "qa_level", "affected_files"]}
          },
          {
            "if": {"properties": {"role": {"const": "qa"}}},
            "then": {"required": ["actor", "writer_model", "task_id", "version", "qa_level", "affected_files", "qa_conclusion", "elapsed_seconds", "execution_model", "next_step", "blocking_issues"]}
          }
        ]
      }
    }
  }
}
