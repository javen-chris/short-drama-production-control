{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javen-chris.github.io/short-drama-production-control/schemas/run_state.schema.json",
  "title": "Pipeline run state and event log",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "contract_id",
    "current_step",
    "status"
  ],
  "$defs": {
    "protocolAttestation": {
      "type": "object",
      "required": [
        "status",
        "attestation_id",
        "run_id",
        "task_id",
        "contract_id",
        "manifest_fingerprint",
        "scope_gate",
        "covered_step_ids",
        "protocol_paths",
        "challenge_ids",
        "verified_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "STALE"
          ]
        },
        "attestation_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope_gate": {
          "type": "string",
          "pattern": "^G[0-8]$"
        },
        "covered_step_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "protocol_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "challenge_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verified_at": {
          "type": "string",
          "minLength": 1
        },
        "protocol_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "invalidated_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "current_step": {
      "type": "string",
      "minLength": 0
    },
    "pipeline": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "segment": {
      "type": "string"
    },
    "segment_title": {
      "type": "string"
    },
    "series": {
      "type": "string"
    },
    "episode": {
      "type": "string"
    },
    "project_root": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "execution_model": {
      "type": "string",
      "minLength": 1
    },
    "qa_model": {
      "type": "string",
      "minLength": 1
    },
    "execution_contract": {
      "type": "object"
    },
    "protocol_attestation": {
      "$ref": "#/$defs/protocolAttestation"
    },
    "protocol_attestations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/protocolAttestation"
      }
    },
    "protocol_migrations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "resume_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "from_step_id", "to_step_id", "reason"],
        "properties": {
          "at": {"type": "string", "minLength": 1},
          "from_step_id": {"type": "string"},
          "to_step_id": {"type": "string"},
          "reason": {"type": "string", "minLength": 1},
          "provider_task_id": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "submission_authorizations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scope",
          "provider",
          "authorized_at",
          "statement",
          "evidence",
          "evidence_sha256",
          "run_id",
          "contract_id"
        ],
        "properties": {
          "scope": {
            "const": "single_video_submission"
          },
          "provider": {
            "enum": [
              "runninghub",
              "xiaoyunque",
              "libtv"
            ]
          },
          "authorized_at": {
            "type": "string"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "max_submissions": {
            "const": 1
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "contract_id": {
            "type": "string",
            "minLength": 1
          },
          "authentication": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "step_dispositions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "applicable",
          "reason",
          "step_id",
          "disposition"
        ],
        "properties": {
          "applicable": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "pending",
              "not_applicable"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "status": {
      "enum": [
        "RUNNING",
        "WAITING_APPROVAL",
        "PAUSED_EXCEPTION",
        "COMPLETED",
        "COMPLETED_WITH_CONTINUITY_CAVEAT",
        "USABLE_WITH_SCENE_CONTINUITY_FAIL",
        "SUBMITTED_FOR_QA",
        "SUBMITTED_IN_PROGRESS",
        "TASK_FAILED",
        "FAILED",
        "BLOCKED"
      ]
    },
    "checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "completed_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pending_decision": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "outcome"
        ],
        "properties": {
          "actor": {
            "type": "string",
            "description": "生产提交事件记录执行模型；QA 结论事件记录独立 QA 模型"
          },
          "affected_files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "blocking_issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "execution_model": {
            "type": "string",
            "minLength": 1
          },
          "elapsed_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "elapsed_phase": {
            "enum": [
              "context_reading",
              "production",
              "qa",
              "user_wait",
              "upload",
              "provider_queue",
              "download"
            ]
          },
          "evidence_waived": {
            "type": "boolean"
          },
          "artifact_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "gate": {
            "type": "string",
            "minLength": 1
          },
          "issue_id": {
            "type": "string",
            "minLength": 1
          },
          "next_step": {
            "type": "string",
            "minLength": 1
          },
          "off_protocol": {
            "type": "boolean"
          },
          "qa_attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "qa_conclusion": {
            "enum": [
              "PASS",
              "FAIL",
              "CONDITIONAL",
              "TIMEOUT"
            ]
          },
          "qa_level": {
            "enum": [
              "A",
              "B",
              "C",
              "FINAL"
            ]
          },
          "role": {
            "enum": [
              "producer",
              "qa",
              "executor"
            ]
          },
          "source_adapter": {
            "enum": [
              "runninghub",
              "xiaoyunque",
              "libtv"
            ]
          },
          "provider_task_id": {
            "type": "string",
            "minLength": 1
          },
          "provider_status": {
            "type": "string",
            "minLength": 1
          },
          "output_urls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "step_as_written": {
            "type": "string"
          },
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "contract_id": {
            "type": "string",
            "minLength": 1
          },
          "step_matched_fuzzy": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "writer_model": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "minLength": 1
          },
          "attestation_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "affected_file_hashes": {
            "type": "object",
            "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "outcome": {
            "enum": [
              "SUBMITTED_FOR_QA",
              "SUBMITTED_IN_PROGRESS",
              "TASK_SUBMITTED",
              "TASK_SUCCEEDED",
              "TASK_FAILED",
              "TASK_UNVERIFIED",
              "STEP_COMPLETED",
              "COMPLETED",
              "COMPLETED_WITH_CONTINUITY_CAVEAT",
              "USABLE_WITH_SCENE_CONTINUITY_FAIL",
              "WAITING_APPROVAL",
              "PAUSED_EXCEPTION",
              "BLOCKED",
              "FAILED"
            ]
          },
          "protocol_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "skill_id": {
            "type": "string",
            "minLength": 1
          },
          "step": {
            "type": "string",
            "minLength": 1
          },
          "validator": {
            "type": "string"
          },
          "qa_invocation_evidence": {
            "type": "string"
          },
          "reviewed_packet_sha256": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "SUBMITTED_FOR_QA"
                }
              }
            },
            "then": {
              "required": [
                "actor",
                "writer_model",
                "task_id",
                "version",
                "qa_level",
                "affected_files"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "qa"
                }
              }
            },
            "then": {
              "required": [
                "actor",
                "writer_model",
                "task_id",
                "version",
                "qa_level",
                "affected_files",
                "qa_conclusion",
                "elapsed_seconds",
                "execution_model",
                "next_step",
                "blocking_issues"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "executor"
                }
              }
            },
            "then": {
              "required": [
                "source_adapter",
                "provider_task_id",
                "provider_status",
                "evidence",
                "step_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "TASK_SUCCEEDED"
                }
              }
            },
            "then": {
              "required": [
                "output_urls"
              ]
            }
          }
        ]
      }
    },
    "final_submission_versions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "protocol_invalidations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "submission_exception": {
      "type": "string"
    }
  }
}
