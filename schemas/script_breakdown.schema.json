{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javen-chris.github.io/short-drama-production-control/schemas/script_breakdown.schema.json",
  "title": "Confirmed script breakdown",
  "type": "object", "additionalProperties": false,
  "required": ["script_id", "project", "segment", "version", "status", "hook", "beat_chain", "change_points", "confirmed_plot"],
  "properties": {
    "script_id": {"type": "string", "minLength": 1}, "project": {"type": "string", "minLength": 1}, "segment": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
    "status": {"const": "PASS"}, "hook": {"type": "string", "minLength": 1},
    "beat_chain": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 1}},
    "change_points": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "confirmed_plot": {"type": "boolean", "const": true}
  }
}

