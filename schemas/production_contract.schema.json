{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javen-chris.github.io/short-drama-production-control/schemas/production_contract.schema.json",
  "title": "Short Drama Production Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "project", "segment", "current_gate", "provider", "target", "authorization", "assets", "prompt_unit", "storyboard_mode"],
  "properties": {
    "contract_id": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "segment": {"type": "string", "minLength": 1},
    "current_gate": {"enum": ["G0", "G1", "G2", "G3", "G4", "G5", "G6", "G7", "G8"]},
    "provider": {"enum": ["runninghub", "xiaoyunque", "libtv"]},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["duration_seconds", "resolution", "aspect_ratio"],
      "properties": {
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
        "resolution": {"enum": ["720p", "1080p", "other"]},
        "aspect_ratio": {"enum": ["9:16", "16:9", "1:1", "other"]}
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["video_submission_authorized", "max_submissions", "allow_retry", "allow_model_switch", "allow_publish", "allow_master_overwrite", "allow_tail_frame_generation", "allow_storyboard_generation"],
      "properties": {
        "video_submission_authorized": {"type": "boolean"},
        "max_submissions": {"type": "integer", "minimum": 0},
        "allow_retry": {"const": false},
        "allow_model_switch": {"const": false},
        "allow_publish": {"const": false},
        "allow_master_overwrite": {"const": false},
        "allow_tail_frame_generation": {"type": "boolean"},
        "allow_storyboard_generation": {"type": "boolean"}
      }
    },
    "assets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "path", "purpose"],
        "properties": {
          "role": {"enum": ["character_master", "scene_master", "prop_master", "real_tail_frame", "storyboard_composite", "keyframe"]},
          "path": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "storyboard_mode": {"enum": ["direct_prompt", "keyframe_assisted", "storyboard_required", "degraded_direct"]},
    "prompt_unit": {"$ref": "prompt_unit.schema.json"}
  }
}

