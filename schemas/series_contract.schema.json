{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javen-chris.github.io/short-drama-production-control/schemas/series_contract.schema.json",
  "title": "Series contract (stable layer)",
  "description": "Everything that must stay identical across every shot of a series: identity baseline, wardrobe baseline, world art direction, frame defaults, and series-wide prohibitions. Shot-specific content never belongs here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["series_id", "art_direction", "identity_baseline", "frame_defaults", "prohibitions"],
  "properties": {
    "series_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "authority_source": {"type": "string", "minLength": 1},
    "art_direction": {"type": "string", "minLength": 1},
    "identity_baseline": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["character_name", "identity_asset_id"],
        "properties": {
          "character_name": {"type": "string", "minLength": 1},
          "identity_asset_id": {"type": "string", "minLength": 1},
          "wardrobe_baseline_asset_id": {"type": "string", "minLength": 1},
          "relationships": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "frame_defaults": {
      "type": "object", "additionalProperties": false,
      "required": ["aspect_ratio", "resolution", "quality_floor"],
      "properties": {
        "aspect_ratio": {"enum": ["9:16", "16:9", "1:1", "other"]},
        "resolution": {"enum": ["720p", "1080p", "other"]},
        "quality_floor": {"type": "string", "minLength": 1}
      }
    },
    "prohibitions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "image_model": {"const": "gpt-image-2"}
  }
}
