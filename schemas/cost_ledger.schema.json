{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javen-chris.github.io/short-drama-production-control/schemas/cost_ledger.schema.json",
  "title": "Cost ledger and submission idempotency",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "budget_cny": {"type": "number", "minimum": 0},
    "entries": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["idempotency_key", "unit_id", "contract_id", "provider", "status"],
        "properties": {
          "idempotency_key": {"type": "string", "minLength": 1},
          "unit_id": {"type": "string", "minLength": 1},
          "contract_id": {"type": "string", "minLength": 1},
          "provider": {"enum": ["runninghub", "xiaoyunque", "libtv"]},
          "task_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PENDING", "SUCCEEDED", "FAILED", "UNKNOWN"]},
          "cost_cny": {"type": "number", "minimum": 0},
          "input_hash": {"type": "string", "minLength": 1},
          "submitted_at": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
